# Copy to .env to override the defaults in docker-compose.yml.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
ADMIN_NAME=Arthur Vance
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
# Seeds demo voters, candidates and two votes on first boot.
SEED_DEMO=true
# Where the frontend repo is cloned, relative to this folder.
FRONTEND_PATH=../voting-apps-front
